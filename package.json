{
  "name": "dsh-salary-meter",
  "version": "0.1.0",
  "description": "打工养肥鱼，实时工资、下班倒计时和模型饭钱估算",
  "type": "module",
  "main": "./index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.mjs", "core.mjs", "client.js", "assets", "icon.svg", "locale", "cordis.patch.yml", "README.md"],
  "scripts": { "test": "node --test core.test.mjs" },
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/Jiang-Xiaoxing/dsh-salary-meter.git" },
  "homepage": "https://github.com/Jiang-Xiaoxing/dsh-salary-meter#readme",
  "keywords": ["dsh-plugin", "deepseek-harness", "salary", "widget", "pet"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots"], "external": ["react", "@deepseek-ai/dsh-client-ui-primitives"] },
    "compatibility": { "dshReleases": { "0.2.1-rc.3": "compatible", "0.2.1-rc.4": "unknown", "0.2.1-rc.5": "unknown" } }
  },
  "license": "MIT"
}
